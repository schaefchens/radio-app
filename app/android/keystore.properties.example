# Copy to app/android/keystore.properties (gitignored) and fill in.
#
# This is the Play *upload* key: Google signs what reaches phones with its own
# key (Play App Signing), and this one proves an upload comes from us.
# Create it once — keytool comes with the JDK, which is not on PATH:
#
#   mkdir -p ~/keys
#   /opt/homebrew/opt/openjdk@21/bin/keytool -genkeypair -v \
#     -keystore ~/keys/arche-radio-upload.keystore \
#     -alias arche -keyalg RSA -keysize 4096 -validity 10000
#
# BACK THE KEYSTORE AND ITS PASSWORDS UP OFF THIS MACHINE (a password manager
# plus an offline copy). Lost, it can only be replaced through Play support,
# which takes days; until then no update can be uploaded.

storeFile=/Users/css/keys/arche-radio-upload.keystore
storePassword=CHANGEME
keyAlias=arche
keyPassword=CHANGEME
