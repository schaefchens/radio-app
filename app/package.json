{
  "name": "@arche/app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "native:sync": "cap sync",
    "native:ios": "cap run ios",
    "native:ios:xcode": "cap open ios",
    "native:android": "bash ../scripts/native/android-env.sh cap run android",
    "native:aab": "bash ../scripts/native/android-env.sh bash -c 'cd android && ./gradlew bundleRelease'",
    "native:assets": "npx --yes @capacitor/assets@3.0.5 generate --assetPath native/assets --ios --android --iconBackgroundColor '#03234a' --iconBackgroundColorDark '#03234a' --splashBackgroundColor '#03234a' --splashBackgroundColorDark '#03234a'"
  },
  "dependencies": {
    "@arche/shared": "*",
    "@breezystack/lamejs": "^1.2.7",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@scure/bip39": "^2.4.0",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "workbox-window": "^7.4.1"
  }
}
