# Interpolation values for compose.yaml. Deliberately NOT the project .env:
# that file holds the SFTP password and AI keys, and compose would try to
# interpolate them. Containers read secrets from the mounted .env at runtime
# (ARCHE_ENV_FILE) instead. Use the npm scripts, which pass this file.
WEB_PORT=8080
RT_PORT=8787
AI_MODE=stub
