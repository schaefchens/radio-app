# Names only — copy to .env and fill in. .env is gitignored.
#
# The deploy script reads the SFTP_* keys. The server gets an allow-listed copy
# of the rest on `npm run deploy -- --initial` (never the SFTP_* keys).

# --- deploy (Hetzner Webhosting S, SFTP only) -------------------------------
SITE_BASE_URL=https://radio.schaefchens.de
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
SFTP_REMOTE_ROOT=/

# --- AI ---------------------------------------------------------------------
# OpenAI alone is enough (host words, moderation, voice, transcription).
# With ANTHROPIC_KEY set, Claude writes the host's words and moderates instead.
ANTHROPIC_KEY=
OPENAI_KEY=
# stub = no network calls (tests, offline dev); live = real calls
AI_MODE=live
# auto | anthropic | openai
AI_TEXT_PROVIDER=auto
HOST_MODEL=claude-opus-5
MODERATION_MODEL=claude-opus-5
OPENAI_HOST_MODEL=gpt-5-mini
OPENAI_MODERATION_MODEL=gpt-5-mini
AI_DAILY_BUDGET_USD=5
# Voice: openai (default) or elevenlabs. ElevenLabs is only used while
# ELEVENLABS_MAX_CHARS_PER_DAY > 0 and the day's characters are below it.
TTS_PROVIDER=openai
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_EN=
ELEVENLABS_VOICE_DE=
ELEVENLABS_MAX_CHARS_PER_DAY=0

# --- YouTube Data API v3 (library lookups + song request checks) ------------
YOUTUBE_API_KEY=

# --- generated by `npm run init-secrets` (never edit by hand) ---------------
CRON_KEY=
NODE_SECRET=
IDENTITY_PEPPER=
ADMIN_SETUP_KEY=
TOKEN_SIGNING_KEY=
TOKEN_PUBLIC_KEY=

# --- realtime (Phase 4) -----------------------------------------------------
# off (default: no rooms) | static (the local compose node; compose.yaml sets
# it for the dev stack) | hcloud (Hetzner scale-to-zero)
REALTIME_DRIVER=
REALTIME_STATIC_URL=ws://localhost:8787/ws
HETZNER_CLOUD_TOKEN=
REALTIME_SLOTS=
REALTIME_MAX_NODES=1

